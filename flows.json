    {
        "id": "9673a49e220f9659",
        "type": "function",
        "z": "e3d8a003b6e9a4ea",
        "name": "function 2",
        "func": "var golAtual = flow.get(\"goal\");\n\nif (golAtual && golAtual !== flow.get(\"ultimoGol\")) {\n    node.log(\"Gol: Novo gol detectado - enviando via WebSocket\");\n    flow.set(\"ultimoGol\", golAtual);\n\n    let msgGol = {};\n    try {\n        msgGol.payload = JSON.parse(golAtual);\n        msgGol.payload.type = 'gol';\n    } catch (e) {\n        const parts = golAtual.split(',');\n        msgGol.payload = {\n            team: parts[0].trim(),\n            soccer: parts[1].trim(),\n            type: \"gol\"\n        };\n    }\n\n    flow.set(\"stop\", true);\n    setTimeout(() => {\n        flow.set(\"stop\", false);\n        node.log(\"LastTouch liberado\");\n    }, 10000);\n\n    // ENVIA para WebSocket (e mantém HTTP se quiser)\n    return [msgGol, msgGol];\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
