    {
        "id": "8d0a8bfb7df09324",
        "type": "function",
        "z": "e3d8a003b6e9a4ea",
        "name": "function 1",
        "func": "const lastTouch = flow.get(\"lastTouch\");\nconst stop = flow.get(\"stop\");\n\nif (stop || !lastTouch) {\n    node.log(\"LastTouch: Parado ou sem dados\");\n    return null;\n}\n\n// Processa lastTouch\ntry {\n    msg.payload = JSON.parse(lastTouch);\n    msg.payload.type = \"possession\";\n} catch (e) {\n    const parts = lastTouch.split(\",\");\n    msg.payload = {\n        team: parts[0].trim(),\n        soccer: parts[1].trim(),\n        type: \"possession\"\n    };\n}\n\nnode.log(\"LastTouch: Enviando via WebSocket\");\n// ENVIA para WebSocket (e mantém HTTP se quiser)\nreturn [msg, msg];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
